# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── S3 (READ-ONLY access to production bucket) ───────────────────────
S3_BUCKET=prod-castle-hill-toyota
S3_ROOT_PREFIX=prior_condition/
S3_TARGET_SUBFOLDERS=3,7

# ── Log destination (set to a SEPARATE bucket to avoid any writes to prod) ──
# Option A: separate logging bucket (recommended)
LOG_BUCKET=your-logging-bucket
LOG_S3_KEY=pipeline_logs/latest.jsonl
# Option B: disable S3 log upload entirely — logs stay local only
# Set LOG_BUCKET= (empty) to disable

# ── YOLO ────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=best.pt
YOLO_CONF_THRESHOLD=0.25

# ── Vision provider ─────────────────────────────────────────────────
# Choose which model performs the vision verification step.
# Options: openai | claude (default)
VISION_PROVIDER=claude

# Save YOLO-detected images rejected by the vision model for manual review.
# Saved to null_review/<bucket>/ with bounding boxes drawn on them.
SAVE_NULL_REVIEW=true

# JPEG quality for Roboflow uploads and null-review saves (0-95).
UPLOAD_JPEG_QUALITY=100
NULL_REVIEW_JPEG_QUALITY=90

# ── OpenAI ──────────────────────────────────────────────────────────
# Required when VISION_PROVIDER=openai
OPENAI_API_KEY=sk-...
# Model options: gpt-4o (best accuracy), gpt-4o-mini (cheaper, faster)
OPENAI_MODEL=gpt-4o

# ── Anthropic / Claude ───────────────────────────────────────────────
# Required when VISION_PROVIDER=claude
# Install SDK first: pip install anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Model options: claude-sonnet-4-6 (recommended), claude-opus-4-7 (highest accuracy), claude-haiku-4-5 (fastest)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Roboflow ────────────────────────────────────────────────────────
ROBOFLOW_API_KEY=your_rf_key
ROBOFLOW_WORKSPACE=your_workspace
ROBOFLOW_PROJECT=panel_damage_bb

# ── EC2 (leave blank when running locally) ───────────────────────────
EC2_SELF_STOP=false
EC2_INSTANCE_ID=
AWS_REGION=ap-southeast-2

# ── Notifications (leave blank to disable) ───────────────────────────
SNS_TOPIC_ARN=
