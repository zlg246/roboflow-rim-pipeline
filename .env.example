# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── S3 (READ-ONLY access to production bucket) ───────────────────────
S3_BUCKET=prod-castle-hill-toyota
# Wheel scanner images live under this prefix inside the bucket.
RIM_S3_ROOT_PREFIX=wheel_scanner/

# ── Log destination (set to a SEPARATE bucket to avoid any writes to prod) ──
# Option A: separate logging bucket (recommended)
LOG_BUCKET=your-logging-bucket
LOG_S3_KEY=pipeline_logs/latest.jsonl
# Option B: disable S3 log upload entirely — logs stay local only.
# Set LOG_BUCKET= (empty) to disable.

# ── YOLO ────────────────────────────────────────────────────────────
# Path to the rim scratch segmentation model file.
RIM_YOLO_MODEL_PATH=rim_scratch_model.pt
YOLO_CONF_THRESHOLD=0.25
# Douglas-Peucker polygon simplification epsilon (pixels).
# Increase to smooth more aggressively; decrease for tighter but noisier polygons.
POLYGON_SIMPLIFY_EPSILON=2.0

# ── Roboflow ────────────────────────────────────────────────────────
ROBOFLOW_API_KEY=your_rf_key
ROBOFLOW_WORKSPACE=your_workspace
# Rim scratch project: images uploaded with YOLO polygon annotations.
RIM_SCRATCH_ROBOFLOW_PROJECT=test_project-e4bw5
# Rim seg project: all images uploaded without annotations.
RIM_SEG_ROBOFLOW_PROJECT=candidates_test-eicif

# ── Upload ──────────────────────────────────────────────────────────
# JPEG quality for Roboflow uploads (0-100).
UPLOAD_JPEG_QUALITY=100
# Seconds to sleep between uploads (avoids hammering the Roboflow API).
UPLOAD_SLEEP=0.5

# ── Per-bucket credentials ────────────────────────────────────────────
# Buckets that need dedicated IAM credentials: add a pair of vars using
# the bucket name uppercased with hyphens replaced by underscores.
# Buckets with no entry fall back to the default aws configure credentials.
#
#   BUCKET_KEY_<BUCKET>=AKIA...
#   BUCKET_SECRET_<BUCKET>=...
#
# Example for prod-castle-hill-toyota:
#   BUCKET_KEY_PROD_CASTLE_HILL_TOYOTA=AKIA...
#   BUCKET_SECRET_PROD_CASTLE_HILL_TOYOTA=...

# ── EC2 (leave blank when running locally) ───────────────────────────
EC2_SELF_STOP=false
EC2_INSTANCE_ID=
AWS_REGION=ap-southeast-2

# ── Notifications (leave blank to disable) ───────────────────────────
SNS_TOPIC_ARN=
